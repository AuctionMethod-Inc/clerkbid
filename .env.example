# Neon on Vercel injects these (use `vercel env pull`). The app uses a pooled URL:
# POSTGRES_URL, or if unset, DATABASE_URL.
POSTGRES_URL=
# DATABASE_URL=

# Required in production (use the same value for both if you set both):
# openssl rand -base64 32
NEXTAUTH_SECRET=
# AUTH_SECRET=

# Production: https://your-domain.vercel.app (must match the public URL so password-reset links work)
NEXTAUTH_URL=http://localhost:3000

# --- Email (Resend) — password reset, /feedback, and Settings → team invite emails ---
# 1. Create an account at https://resend.com and create an API key.
# 2. CRITICAL: RESEND_FROM must use a domain you have added AND verified under
#    https://resend.com/domains (DNS records). Using e.g. noreply@auctionmethod.com
#    will fail with 403 until auctionmethod.com is verified in *your* Resend team.
#    Until then, verify clerkbid.com (or another domain) and use that in FROM, or
#    use Resend’s documented test/onboarding sender for non-production only.
# 3. In Vercel: Project → Settings → Environment Variables (Production):
#      RESEND_API_KEY=re_...
#      RESEND_FROM=ClerkBid <noreply@your-verified-domain.com>
#      NEXTAUTH_URL=https://clerkbid.com
# 4. Redeploy after changing variables.
RESEND_API_KEY=
RESEND_FROM=

# Where feedback submissions are delivered (defaults to info@auctionmethod.com).
# FEEDBACK_TO_EMAIL=info@auctionmethod.com

# Vercel Cron (monthly backup email). Generate a random secret; set the same value
# in Vercel → Project → Settings → Environment Variables as CRON_SECRET.
# Vercel sends: Authorization: Bearer <CRON_SECRET> to /api/cron/backup-email/
# CRON_SECRET=

# Optional (not used by app code; useful for migrations / Prisma / scripts):
# POSTGRES_URL_NON_POOLING=  (or DATABASE_URL_UNPOOLED for direct connections)

# --- Operation-level sync (optional) — run db/migrate_event_sync_ops.sql first ---
# NEXT_PUBLIC_SYNC_OPS=1
# SYNC_OPS=1

# --- Ably (optional) — in-app realtime nudge after cloud sync writes ---
# Root API key from https://ably.com/dashboard (server only; never expose to the client).
# Publishes to per-event channels vendor:{vendorId}:event:{syncId} and, for super-admin
# announcements, to the global channel clerkbid:announce (standard root key can publish all).
# ABLY_API_KEY=
# Enables WebSocket subscribe for the signed-in user: per-event sync + global clerkbid:announce:
# NEXT_PUBLIC_ABLY_SYNC=1

# --- HubSpot (optional) — Private App access token; syncs new signups to CRM ---
# Create a Private App in HubSpot with scopes: crm.objects.contacts/companies read+write,
# crm.objects.notes write, association write for contacts↔companies, and
# crm.objects.owners.read (to assign contact owner by email).
# If unset, registration works normally and no HubSpot calls are made.
# HUBSPOT_ACCESS_TOKEN=pat-na1-...
#
# Contact owner (Daniel West / daniel@auctionmethod.com by default). Prefer numeric ID to skip API:
# HUBSPOT_CONTACT_OWNER_ID=123456789
# HUBSPOT_CONTACT_OWNER_EMAIL=daniel@auctionmethod.com
#
# Optional custom properties (internal names from HubSpot settings) to tag signups:
# HUBSPOT_CONTACT_SIGNUP_SOURCE_PROP=
# HUBSPOT_CONTACT_SIGNUP_SOURCE_VALUE=ClerkBid
# HUBSPOT_COMPANY_SIGNUP_SOURCE_PROP=
# HUBSPOT_COMPANY_SIGNUP_SOURCE_VALUE=ClerkBid

# --- Feedback loop (optional) — mirrors /feedback submissions to GitHub + Slack ---
# Requires db/migrate_feedback_submissions.sql. Without these the form still emails info@.
# Fine-grained GitHub token with Issues: read/write on the repo below.
# GITHUB_FEEDBACK_TOKEN=github_pat_...
# GITHUB_FEEDBACK_REPO=AuctionMethod-Inc/clerkbid
# Bot token of the "ClerkBid Gate" Slack app (chat:write, channels:history, users:read).
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_FEEDBACK_CHANNEL_ID=C0C9HLJ9H3Q
# Rate limiting is on by default (5/IP/hour, 10/email/day). Set 0 to disable.
# FEEDBACK_RATE_LIMIT_ENABLED=1
# Salt for hashing submitter IPs (any random string).
# FEEDBACK_IP_HASH_SALT=
